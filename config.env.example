# Copy this file to config.env (git-ignored) and fill in real values.
# Auto-loaded into the environment by shared/common.py.

# Hypernative API credentials -- the two halves of one API key, sent as the
# x-client-id / x-client-secret headers. These cover every Hypernative REST
# endpoint (Screener, Pool Toxicity, notification channels, ...).
#
# Used by discover_positions.py for the Pool Toxicity screening. Leave them
# blank and it simply skips that step -- the balance sweep itself needs no
# Hypernative account at all.
#
# Not needed by the agents: the invariantive SDK authenticates on its own.
HYPERNATIVE_CLIENT_ID=
HYPERNATIVE_CLIENT_SECRET=

# Optional. Which Pool Toxicity policies to screen against, comma-separated
# UUIDs, at most 5. Leave blank and discover_positions.py picks one policy
# from your account automatically: the one named "Default PT Policy" if it
# exists, otherwise the first one it finds.
# Policies are created under Screener > Policies in the Hypernative app.
POOL_TOXICITY_POLICY_IDS=
